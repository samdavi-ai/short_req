# Copy this file to .env and fill in your values
# cp .env.example .env

# --- SYSTEM CONFIG ---
PROJECT_NAME="Airport Security Intelligent Surveillance & Tracking"
ENVIRONMENT=development
SECRET_KEY="change-this-to-a-long-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PORT CONFIG ---
FRONTEND_PORT=80
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MILVUS_PORT=19530
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- DATABASE CONFIG ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=airport_surveillance
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+psycopg://postgres:your_strong_password_here@localhost:5432/airport_surveillance

# --- REDIS CONFIG ---
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379/0

# --- MILVUS CONFIG ---
MILVUS_HOST=localhost
MILVUS_PORT=19530

# --- VECTOR STORAGE CONFIG ---
REID_COLLECTION_NAME=airport_reid_vectors
FACE_COLLECTION_NAME=airport_face_vectors

# --- CAMERA PIPELINE SETTINGS ---
MAX_CAMERAS=32
INFERENCE_BATCH_SIZE=4
DETECTION_THRESHOLD=0.5
REID_THRESHOLD=0.72
FACE_MATCH_THRESHOLD=0.68

# --- HARDWARE CONFIG ---
USE_GPU=true
USE_TENSORRT=false
CUDA_DEVICE_NUM=0
